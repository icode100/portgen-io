{
    "version": 2,
    "name": "portgen-io",
    "builds": [
        { "src": "app.js", "use": "@vercel/node" }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "app.js"
        }
    ],
    "env": {
        "MONGO_URI": "@mongo_uri",
        "JWT_KEY": "@jwt_key",
        "JWT_LIFETIME": "@jwt_lifetime",
        "NODE_ENV": "@node_env"
    }
}